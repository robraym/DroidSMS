<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/accessibility_disclosure_title"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/accessibility_disclosure_message"
        android:textColor="@color/textSecondary"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/chkAccessibilityConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:buttonTint="@color/settingsButton"
        android:minHeight="44dp"
        android:text="@string/accessibility_disclosure_checkbox"
        android:textColor="@color/textPrimary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnAgreeAccessibilityDisclosure"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/status_action_button_enabled"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/agree"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDeclineAccessibilityDisclosure"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/dialog_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/not_now"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
