<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/txtRequiredSetupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRequiredSetupMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/textSecondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnContinueRequiredSetup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/status_action_button_enabled"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/continue_action"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCloseRequiredSetup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dialog_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/close_app"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
